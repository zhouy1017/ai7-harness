{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewed runtime model bindings (ADR 0095 §6)",
  "description": "Rows reference reviewed provider documents; endpoint and credential slot are derived there. policyBaseline preserves the predecessor declaration checks; ordinaryProduction selects the v26 runtime choices in display order, default first. No row selects a launch scope or grants a transmission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "developerLive", "legacyDeepSeek", "policyBaseline", "ordinaryProduction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "developerLive": { "$ref": "#/definitions/binding" },
    "legacyDeepSeek": { "$ref": "#/definitions/binding" },
    "policyBaseline": { "$ref": "#/definitions/roles" },
    "ordinaryProduction": { "$ref": "#/definitions/roles" }
  },
  "definitions": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "model"],
      "properties": {
        "route": { "type": "string", "pattern": "^.+$" },
        "model": { "type": "string", "pattern": "^.+$" }
      }
    },
    "bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/binding" } },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "fast"],
      "properties": { "main": { "$ref": "#/definitions/bindings" }, "fast": { "$ref": "#/definitions/bindings" } }
    }
  }
}
