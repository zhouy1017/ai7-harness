# Manuscripts and private sample Books remain local-only. Document formats
# are ignored everywhere by default. ADR 0043 permits only exact-root
# SampleBooks files that the Owner separately designates through an
# authorized Issue and pull request; placement alone is not admission.
*.doc
*.docx
*.odt
*.rtf
*.pdf
!/SampleBooks/
!/SampleBooks/**

# Local secrets and credential material never enter the repository.
.env
*.key
*.pem

# Generated dependencies, builds, caches, business stores, and diagnostics.
node_modules/
dist/
.cache/
.runtime/
.pnpm-store/
test-results/
*.log
*.sqlite
*.sqlite-*
*.db
*.db-*
*.key.txt
