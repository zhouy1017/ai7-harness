{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI7 Provider Processing Policy v4",
  "description": "Validates the exact developer-live Provider Processing v4 authority contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaDialect",
    "schemaPath",
    "documentType",
    "policyId",
    "policyType",
    "version",
    "lifecycleStatus",
    "predecessorVersion",
    "predecessorCanonicalPath",
    "canonicalPath",
    "humanProjectionPath",
    "operationalScope",
    "authorityBasis",
    "trustedSelection",
    "decision",
    "outboundDataCategories",
    "credentialBoundary",
    "authoritySeparations"
  ],
  "properties": {
    "schemaDialect": {
      "const": "http://json-schema.org/draft-07/schema#"
    },
    "schemaPath": {
      "const": "docs/policies/provider-processing-policy.v4.schema.json"
    },
    "documentType": {
      "const": "ai7-policy-document"
    },
    "policyId": {
      "const": "provider-processing-policy"
    },
    "policyType": {
      "const": "provider-processing"
    },
    "version": {
      "const": "v4"
    },
    "lifecycleStatus": {
      "const": "active"
    },
    "predecessorVersion": {
      "const": "v3"
    },
    "predecessorCanonicalPath": {
      "const": "docs/policies/provider-processing-policy.v3.json"
    },
    "canonicalPath": {
      "const": "docs/policies/provider-processing-policy.v4.json"
    },
    "humanProjectionPath": {
      "const": "docs/policies/provider-processing-policy.v4.md"
    },
    "operationalScope": {
      "const": "developer-live"
    },
    "authorityBasis": {
      "const": [
        "docs/domain/execution/CONTEXT.md",
        "docs/adr/0007-separate-decisions-authority-and-effect-proof.md",
        "docs/adr/0016-proprietary-license-and-local-only-sample-manuscripts.md",
        "docs/adr/0043-allow-public-samplebooks-in-repository-and-ci.md",
        "docs/adr/0046-separate-provider-processing-by-operational-scope.md",
        "docs/adr/0065-admit-a-developer-live-provider-processing-scope.md",
        "docs/adr/0067-authorize-the-opencode-go-development-credential-with-live-once-testing.md",
        "docs/architecture-v2/HARNESS-INTEGRATION.md"
      ]
    },
    "trustedSelection": {
      "const": {
        "selectionAuthorityClass": "trusted-build-or-launch-authority",
        "launchArgument": "--trusted-operational-scope developer-live",
        "developerHostOnly": true,
        "hostedOrCiSelectionAllowed": false,
        "ordinaryProductSettingAllowed": false,
        "environmentVariableSelectorAllowed": false,
        "providerSelectorAllowed": false,
        "artifactOrPluginSelectorAllowed": false,
        "crossScopeFallbackAllowed": false,
        "selectionConfiguresProvider": false,
        "selectionDispatchesRun": false
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "providerAllowRules"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "providerAllowRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "$ref": "#/definitions/developerLiveRule"
            }
          ]
        }
      }
    },
    "outboundDataCategories": {
      "const": {
        "public-or-synthetic": {
          "labelZh": "公开或合成内容"
        },
        "unpublished-metadata": {
          "labelZh": "未公开材料元数据"
        },
        "unpublished-excerpts": {
          "labelZh": "未公开材料选段"
        },
        "unpublished-full-content": {
          "labelZh": "未公开材料全文"
        }
      }
    },
    "credentialBoundary": {
      "const": {
        "isOutboundDataCategory": false,
        "permittedInModelVisibleMaterial": false,
        "permittedInGeneralOutboundMaterial": false,
        "opaqueReferenceOnlyOutsideFinalConsumer": true,
        "credentialBrokerResolutionRequired": true,
        "finalAdapterOnly": true,
        "protectedSecretStoreOnly": true,
        "enrollmentHelperIsOnlyKeyFileReader": true,
        "policyEligibilityConfiguresCredential": false
      }
    },
    "authoritySeparations": {
      "const": {
        "policyEligibilityDispatchesProviderCall": false,
        "policyEligibilityCreatesProviderImplementation": false,
        "runSourceScopeAloneAuthorizesTransmission": false,
        "runAuthorizationAloneOverridesThisPolicy": false,
        "configuredProviderAloneAuthorizesTransmission": false,
        "providerSetupAloneAuthorizesTransmission": false,
        "configuredCredentialAloneAuthorizesTransmission": false,
        "artifactInstallOrEnablementAuthorizesTransmission": false,
        "dshSessionOrPluginMembershipAuthorizesTransmission": false,
        "defaultExecutionRuleWithoutUserInitiatedTaskAuthorizesTransmission": false,
        "backgroundAnalysisEnrollmentAuthorizesTransmission": false,
        "externalExportPolicyAuthorizesProviderTransmission": false,
        "effectApprovalAuthorizesProviderTransmission": false,
        "providerResultCacheIsRecordedDeterministicModelFixture": false,
        "providerResultCacheProvesProviderConformance": false,
        "providerProcessingAuthorizesManuscriptApply": false,
        "providerProcessingAuthorizesLearning": false,
        "providerProcessingAuthorizesPublication": false,
        "providerProcessingGrantsPublicReleasePermission": false
      }
    }
  },
  "definitions": {
    "developerLiveRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "policyResult",
        "purpose",
        "authorityOrigin",
        "executionMode",
        "source",
        "allowedOutboundDataCategories",
        "providerBinding",
        "transmissions",
        "authorizationPreconditions",
        "providerAccountLimit",
        "capture",
        "additionalPrivacyPrompts"
      ],
      "properties": {
        "ruleId": {
          "const": "developer-live-public-samplebook-analysis"
        },
        "policyResult": {
          "const": "eligible-only"
        },
        "purpose": {
          "const": "developer-live-prompt-and-pipeline-tuning"
        },
        "authorityOrigin": {
          "const": {
            "newlyUserInitiatedTaskRequired": true,
            "directRunAuthorizationAllowed": true,
            "matchingActiveDefaultExecutionRuleAllowed": false,
            "backgroundAnalysisEnrollmentAllowed": false,
            "idleScheduledImportTriggeredOrCrossRunDispatchAllowed": false
          }
        },
        "executionMode": {
          "const": {
            "humanAttended": true,
            "developerHostOnly": true,
            "ciAllowed": false,
            "hostedAllowed": false,
            "scheduledAllowed": false,
            "backgroundAllowed": false
          }
        },
        "source": {
          "const": {
            "admittedInputs": "owner-designated-public-samplebooks-under-adr-0043",
            "transmittableSetFixedByImplementingSlice": true,
            "privateManuscriptAllowed": false,
            "otherBookRefusedBeforeDispatch": true
          }
        },
        "allowedOutboundDataCategories": {
          "const": [
            "public-or-synthetic"
          ]
        },
        "providerBinding": {
          "const": {
            "modelRole": "Main Editorial Role",
            "route": "opencode-go",
            "endpoint": "https://opencode.ai/zen/go/v1/chat/completions",
            "model": "deepseek-v4-flash",
            "credentialSlot": "opencode-go",
            "exactProviderBindingRequired": true,
            "fallbackAllowed": false,
            "approvedFallbackChainMaximumItems": 0,
            "secondModelAllowed": false,
            "productionDefaultsChanged": false
          }
        },
        "transmissions": {
          "const": {
            "boundedByCoverageManifestUnitCount": true,
            "plusDeclaredSafeRetryAdaptations": true,
            "oneTechnicalSessionPerAnalysisUnit": true,
            "accumulatingSingleSessionAllowed": false,
            "identicalRequestReplaysFromProviderResultCache": true,
            "repeatedTestItemIdentifierAllowed": false
          }
        },
        "authorizationPreconditions": {
          "const": {
            "eligibleConfiguredProviderRequired": true,
            "providerPreflightRequired": true,
            "exactProviderBindingRequired": true,
            "planEnvelopeRequired": true,
            "runAuthorizationRequired": true,
            "runSourceScopeRequired": true,
            "declaredOperationClassesRequired": true,
            "exactRunBudgetCeilingStateRequired": true,
            "unsetRunBudgetCeilingAllowed": false,
            "defaultRunBudgetCeilingTotalTokens": 500000,
            "ceilingEvaluatedBeforeEveryDispatch": true,
            "finalProviderPayloadEgressGateRequired": true,
            "frozenBeforeTransmission": true
          }
        },
        "providerAccountLimit": {
          "const": {
            "classification": "quota-exhausted",
            "endsRunAsProviderAccountLimit": true,
            "retryAllowed": false,
            "fallbackAllowed": false,
            "secondModelAllowed": false
          }
        },
        "capture": {
          "const": {
            "fixtureEmissionAllowed": false,
            "uploadAllowed": false,
            "providerResultCacheAllowed": true,
            "cacheLocation": "protected-local-staging-outside-every-checkout",
            "rawBytesInLogsDiagnosticsOrRepositoryAllowed": false,
            "repositoryEntryOnlyThroughReviewedFixtureGeneration": true
          }
        },
        "additionalPrivacyPrompts": {
          "const": {
            "perBookRequired": false,
            "firstUseRequired": false,
            "perCallRequired": false,
            "perChunkRequired": false
          }
        }
      }
    }
  }
}
