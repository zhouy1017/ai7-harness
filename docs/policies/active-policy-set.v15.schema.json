{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI7 Active Policy Set v15",
  "description": "Exact scope mapping: unchanged v1/v2 and External Export v2; ordinary-production v23 (v21 plus a custom-analysis rule with the editor-authored-question-template outbound category, and the series-knowledge-excerpt category with source.seriesKnowledgeAllowed true on the review rule); developer-live v22 (v20 plus the same two changes). Direct successor of v14.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaDialect",
    "schemaPath",
    "manifestType",
    "version",
    "predecessorVersion",
    "predecessorCanonicalPath",
    "digestAlgorithm",
    "trustedOperationalScopeSelection",
    "activePolicies"
  ],
  "properties": {
    "schemaDialect": {
      "const": "http://json-schema.org/draft-07/schema#"
    },
    "schemaPath": {
      "const": "docs/policies/active-policy-set.v15.schema.json"
    },
    "manifestType": {
      "const": "ai7-active-policy-set"
    },
    "version": {
      "const": "v15"
    },
    "predecessorVersion": {
      "const": "v14"
    },
    "predecessorCanonicalPath": {
      "const": "docs/policies/active-policy-set.v14.json"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "trustedOperationalScopeSelection": {
      "const": {
        "exactlyOneProviderProcessingScopeBoundPerLaunch": true,
        "selectionAuthorityClass": "trusted-build-or-launch-authority",
        "ordinaryProductSettingAllowed": false,
        "environmentVariableSelectorAllowed": false,
        "providerSelectorAllowed": false,
        "artifactOrPluginSelectorAllowed": false,
        "crossScopeFallbackAllowed": false,
        "missingOrUnknownScopeResult": "deny-provider-processing"
      }
    },
    "activePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider-processing-policy",
        "external-export-policy"
      ],
      "properties": {
        "provider-processing-policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionType",
            "scopePins"
          ],
          "properties": {
            "selectionType": {
              "const": "trusted-operational-scope-map"
            },
            "scopePins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "development-ci",
                "fixture-recording",
                "ordinary-production",
                "developer-live"
              ],
              "properties": {
                "development-ci": {
                  "$ref": "#/definitions/providerV1Pin"
                },
                "fixture-recording": {
                  "$ref": "#/definitions/providerV2Pin"
                },
                "ordinary-production": {
                  "const": {
                    "policyId": "provider-processing-policy",
                    "policyType": "provider-processing",
                    "version": "v23",
                    "canonicalPath": "docs/policies/provider-processing-policy.v23.json",
                    "sha256": "311f60232c6e3424e64e0a0f760402c2fe07f4bca71a0299b37d295a7baa6dcb"
                  }
                },
                "developer-live": {
                  "const": {
                    "policyId": "provider-processing-policy",
                    "policyType": "provider-processing",
                    "version": "v22",
                    "canonicalPath": "docs/policies/provider-processing-policy.v22.json",
                    "sha256": "dc78f4517ec8135edb4fdcc759d1c230fc4db5ef7f5c42f217c12aac4173c90b"
                  }
                }
              }
            }
          }
        },
        "external-export-policy": {
          "$ref": "#/definitions/externalExportPin"
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerV1Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "provider-processing-policy"
        },
        "policyType": {
          "const": "provider-processing"
        },
        "version": {
          "const": "v1"
        },
        "canonicalPath": {
          "const": "docs/policies/provider-processing-policy.v1.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "providerV2Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "provider-processing-policy"
        },
        "policyType": {
          "const": "provider-processing"
        },
        "version": {
          "const": "v2"
        },
        "canonicalPath": {
          "const": "docs/policies/provider-processing-policy.v2.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "externalExportPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "external-export-policy"
        },
        "policyType": {
          "const": "external-export"
        },
        "version": {
          "const": "v2"
        },
        "canonicalPath": {
          "const": "docs/policies/external-export-policy.v2.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
