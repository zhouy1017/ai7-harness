{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI7 External Export Policy v1",
  "description": "Validates the exact default-deny External Export Policy v1 baseline and its sole local-filesystem eligibility rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaDialect",
    "schemaPath",
    "documentType",
    "policyId",
    "policyType",
    "version",
    "lifecycleStatus",
    "predecessorVersion",
    "canonicalPath",
    "humanProjectionPath",
    "authorityBasis",
    "decision",
    "perFileEffectRequirements",
    "authoritySeparations"
  ],
  "properties": {
    "schemaDialect": {
      "enum": [
        "http://json-schema.org/draft-07/schema#"
      ]
    },
    "schemaPath": {
      "enum": [
        "docs/policies/external-export-policy.v1.schema.json"
      ]
    },
    "documentType": {
      "enum": [
        "ai7-policy-document"
      ]
    },
    "policyId": {
      "enum": [
        "external-export-policy"
      ]
    },
    "policyType": {
      "enum": [
        "external-export"
      ]
    },
    "version": {
      "enum": [
        "v1"
      ]
    },
    "lifecycleStatus": {
      "enum": [
        "active"
      ]
    },
    "predecessorVersion": {
      "type": "null"
    },
    "canonicalPath": {
      "enum": [
        "docs/policies/external-export-policy.v1.json"
      ]
    },
    "humanProjectionPath": {
      "enum": [
        "docs/policies/external-export-policy.md"
      ]
    },
    "authorityBasis": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "docs/domain/execution/CONTEXT.md",
          "docs/adr/0007-separate-decisions-authority-and-effect-proof.md",
          "docs/adr/0018-tiered-activation-for-agent-authored-revisions.md",
          "docs/adr/0038-separate-delivery-package-identity-from-local-export.md",
          "docs/adr/0039-delegate-local-export-collisions-to-native-os-workflows.md",
          "docs/architecture-v2/HARNESS-INTEGRATION.md"
        ]
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "allowRules",
        "excludedDestinationKinds"
      ],
      "properties": {
        "default": {
          "enum": [
            "deny"
          ]
        },
        "allowRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/localFilesystemRule"
          }
        },
        "excludedDestinationKinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "cloud",
            "email"
          ],
          "properties": {
            "network": {
              "enum": [
                true
              ]
            },
            "cloud": {
              "enum": [
                true
              ]
            },
            "email": {
              "enum": [
                true
              ]
            }
          }
        }
      }
    },
    "perFileEffectRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localExportPreparation",
        "effectIntent",
        "effectApproval",
        "commitAndVerification",
        "outcomeEvidence",
        "driftInvalidation",
        "cancellation",
        "nativeBatchChoice"
      ],
      "properties": {
        "localExportPreparation": {
          "$ref": "#/definitions/localExportPreparation"
        },
        "effectIntent": {
          "$ref": "#/definitions/effectIntent"
        },
        "effectApproval": {
          "$ref": "#/definitions/effectApproval"
        },
        "commitAndVerification": {
          "$ref": "#/definitions/commitAndVerification"
        },
        "outcomeEvidence": {
          "$ref": "#/definitions/outcomeEvidence"
        },
        "driftInvalidation": {
          "$ref": "#/definitions/driftInvalidation"
        },
        "cancellation": {
          "$ref": "#/definitions/cancellation"
        },
        "nativeBatchChoice": {
          "$ref": "#/definitions/nativeBatchChoice"
        }
      }
    },
    "authoritySeparations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyEligibilityIsEffectApproval",
        "localExportGrantsPublicReleasePermission",
        "localExportProvesPublicReleasePermission",
        "localExportProvesSending",
        "localExportProvesDelivery",
        "localExportProvesPublication",
        "platformResponseIsEffectReceipt",
        "harnessOrToolResultIsEffectReceipt"
      ],
      "properties": {
        "policyEligibilityIsEffectApproval": {
          "enum": [
            false
          ]
        },
        "localExportGrantsPublicReleasePermission": {
          "enum": [
            false
          ]
        },
        "localExportProvesPublicReleasePermission": {
          "enum": [
            false
          ]
        },
        "localExportProvesSending": {
          "enum": [
            false
          ]
        },
        "localExportProvesDelivery": {
          "enum": [
            false
          ]
        },
        "localExportProvesPublication": {
          "enum": [
            false
          ]
        },
        "platformResponseIsEffectReceipt": {
          "enum": [
            false
          ]
        },
        "harnessOrToolResultIsEffectReceipt": {
          "enum": [
            false
          ]
        }
      }
    }
  },
  "definitions": {
    "trueValue": {
      "enum": [
        true
      ]
    },
    "falseValue": {
      "enum": [
        false
      ]
    },
    "localFilesystemRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "policyResult",
        "effectKind",
        "destination",
        "target"
      ],
      "properties": {
        "ruleId": {
          "enum": [
            "user-selected-local-filesystem-file"
          ]
        },
        "policyResult": {
          "enum": [
            "eligible-only"
          ]
        },
        "effectKind": {
          "enum": [
            "file-effect"
          ]
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "objectKind",
            "selection"
          ],
          "properties": {
            "kind": {
              "enum": [
                "local-filesystem"
              ]
            },
            "objectKind": {
              "enum": [
                "file"
              ]
            },
            "selection": {
              "enum": [
                "platform-native-user-selector"
              ]
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exactIdentityRequired",
            "eligibleKinds"
          ],
          "properties": {
            "exactIdentityRequired": {
              "$ref": "#/definitions/trueValue"
            },
            "eligibleKinds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "delivery-package-version",
                  "editorial-deliverable-revision"
                ]
              }
            }
          }
        }
      }
    },
    "localExportPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "perFile",
        "frozen",
        "createdAfterNativeDestinationAndCollisionResolution",
        "bindings"
      ],
      "properties": {
        "required": {
          "$ref": "#/definitions/trueValue"
        },
        "perFile": {
          "$ref": "#/definitions/trueValue"
        },
        "frozen": {
          "$ref": "#/definitions/trueValue"
        },
        "createdAfterNativeDestinationAndCollisionResolution": {
          "$ref": "#/definitions/trueValue"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exactTargetObjectAndVersionOrRevision",
            "renderedFormat",
            "filename",
            "finalLocalPath",
            "fidelityDisposition",
            "payloadDigest",
            "createOrReplaceDisposition",
            "externalExportPolicyIdAndVersion"
          ],
          "properties": {
            "exactTargetObjectAndVersionOrRevision": {
              "$ref": "#/definitions/trueValue"
            },
            "renderedFormat": {
              "$ref": "#/definitions/trueValue"
            },
            "filename": {
              "$ref": "#/definitions/trueValue"
            },
            "finalLocalPath": {
              "$ref": "#/definitions/trueValue"
            },
            "fidelityDisposition": {
              "$ref": "#/definitions/trueValue"
            },
            "payloadDigest": {
              "$ref": "#/definitions/trueValue"
            },
            "createOrReplaceDisposition": {
              "$ref": "#/definitions/trueValue"
            },
            "externalExportPolicyIdAndVersion": {
              "$ref": "#/definitions/trueValue"
            }
          }
        }
      }
    },
    "effectIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "stableIdentityRequired",
        "bindsExactLocalExportPreparation",
        "bindsExactTargetPayloadAndPolicy"
      ],
      "properties": {
        "required": {
          "$ref": "#/definitions/trueValue"
        },
        "stableIdentityRequired": {
          "$ref": "#/definitions/trueValue"
        },
        "bindsExactLocalExportPreparation": {
          "$ref": "#/definitions/trueValue"
        },
        "bindsExactTargetPayloadAndPolicy": {
          "$ref": "#/definitions/trueValue"
        }
      }
    },
    "effectApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "exactEffectIntentOnly",
        "separateFromPolicyEligibility",
        "requiredBeforeCommit"
      ],
      "properties": {
        "required": {
          "$ref": "#/definitions/trueValue"
        },
        "exactEffectIntentOnly": {
          "$ref": "#/definitions/trueValue"
        },
        "separateFromPolicyEligibility": {
          "$ref": "#/definitions/trueValue"
        },
        "requiredBeforeCommit": {
          "$ref": "#/definitions/trueValue"
        }
      }
    },
    "commitAndVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageBeforeTargetMutation",
        "atomicFileCommit",
        "verifyFinalLocalOutcome",
        "receiptOnlyAfterVerification"
      ],
      "properties": {
        "stageBeforeTargetMutation": {
          "$ref": "#/definitions/trueValue"
        },
        "atomicFileCommit": {
          "$ref": "#/definitions/trueValue"
        },
        "verifyFinalLocalOutcome": {
          "$ref": "#/definitions/trueValue"
        },
        "receiptOnlyAfterVerification": {
          "$ref": "#/definitions/trueValue"
        }
      }
    },
    "outcomeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perFile",
        "successRequiresEffectReceipt",
        "nonSuccessRequiresClassifiedOutcome",
        "ambiguousOutcomeAllowsAutomaticRetry",
        "ambiguousOutcomeRequiresReconciliation"
      ],
      "properties": {
        "perFile": {
          "$ref": "#/definitions/trueValue"
        },
        "successRequiresEffectReceipt": {
          "$ref": "#/definitions/trueValue"
        },
        "nonSuccessRequiresClassifiedOutcome": {
          "$ref": "#/definitions/trueValue"
        },
        "ambiguousOutcomeAllowsAutomaticRetry": {
          "$ref": "#/definitions/falseValue"
        },
        "ambiguousOutcomeRequiresReconciliation": {
          "$ref": "#/definitions/trueValue"
        }
      }
    },
    "driftInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialTargetPayloadOrPolicyDriftInvalidatesPreparationIntentAndApproval",
        "pathOrDispositionChangeRequiresNewNativeResolution"
      ],
      "properties": {
        "materialTargetPayloadOrPolicyDriftInvalidatesPreparationIntentAndApproval": {
          "$ref": "#/definitions/trueValue"
        },
        "pathOrDispositionChangeRequiresNewNativeResolution": {
          "$ref": "#/definitions/trueValue"
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "attemptedFileEffect",
        "effectReceipt"
      ],
      "properties": {
        "classification": {
          "enum": [
            "no-effect"
          ]
        },
        "attemptedFileEffect": {
          "$ref": "#/definitions/falseValue"
        },
        "effectReceipt": {
          "$ref": "#/definitions/falseValue"
        }
      }
    },
    "nativeBatchChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onlyExactCurrentlyEnumeratedCollisions",
        "standingOverwritePermission"
      ],
      "properties": {
        "onlyExactCurrentlyEnumeratedCollisions": {
          "$ref": "#/definitions/trueValue"
        },
        "standingOverwritePermission": {
          "$ref": "#/definitions/falseValue"
        }
      }
    }
  }
}
