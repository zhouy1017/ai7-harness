{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI7 Active Policy Set v10",
  "description": "Exact scope mapping: unchanged v1/v2 and External Export v2; ordinary-production v13 (local user-credential production, two selectable routes); developer-live v12 (v11 plus cross-deliverable review and material-bearing review, writing and evaluation). Direct successor of v9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaDialect",
    "schemaPath",
    "manifestType",
    "version",
    "predecessorVersion",
    "predecessorCanonicalPath",
    "digestAlgorithm",
    "trustedOperationalScopeSelection",
    "activePolicies"
  ],
  "properties": {
    "schemaDialect": {
      "const": "http://json-schema.org/draft-07/schema#"
    },
    "schemaPath": {
      "const": "docs/policies/active-policy-set.v10.schema.json"
    },
    "manifestType": {
      "const": "ai7-active-policy-set"
    },
    "version": {
      "const": "v10"
    },
    "predecessorVersion": {
      "const": "v9"
    },
    "predecessorCanonicalPath": {
      "const": "docs/policies/active-policy-set.v9.json"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "trustedOperationalScopeSelection": {
      "const": {
        "exactlyOneProviderProcessingScopeBoundPerLaunch": true,
        "selectionAuthorityClass": "trusted-build-or-launch-authority",
        "ordinaryProductSettingAllowed": false,
        "environmentVariableSelectorAllowed": false,
        "providerSelectorAllowed": false,
        "artifactOrPluginSelectorAllowed": false,
        "crossScopeFallbackAllowed": false,
        "missingOrUnknownScopeResult": "deny-provider-processing"
      }
    },
    "activePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider-processing-policy",
        "external-export-policy"
      ],
      "properties": {
        "provider-processing-policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionType",
            "scopePins"
          ],
          "properties": {
            "selectionType": {
              "const": "trusted-operational-scope-map"
            },
            "scopePins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "development-ci",
                "fixture-recording",
                "ordinary-production",
                "developer-live"
              ],
              "properties": {
                "development-ci": {
                  "$ref": "#/definitions/providerV1Pin"
                },
                "fixture-recording": {
                  "$ref": "#/definitions/providerV2Pin"
                },
                "ordinary-production": {
                  "const": {
                    "policyId": "provider-processing-policy",
                    "policyType": "provider-processing",
                    "version": "v13",
                    "canonicalPath": "docs/policies/provider-processing-policy.v13.json",
                    "sha256": "465f6bb3b43d522c2464f0589e6302600799192ee46ba17df23269f08f94ea3e"
                  }
                },
                "developer-live": {
                  "const": {
                    "policyId": "provider-processing-policy",
                    "policyType": "provider-processing",
                    "version": "v12",
                    "canonicalPath": "docs/policies/provider-processing-policy.v12.json",
                    "sha256": "9bc27046af27c2967482c51ec4850668df13154a8c8e3ad94bdcb6fae3b47b2c"
                  }
                }
              }
            }
          }
        },
        "external-export-policy": {
          "$ref": "#/definitions/externalExportPin"
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerV1Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "provider-processing-policy"
        },
        "policyType": {
          "const": "provider-processing"
        },
        "version": {
          "const": "v1"
        },
        "canonicalPath": {
          "const": "docs/policies/provider-processing-policy.v1.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "providerV2Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "provider-processing-policy"
        },
        "policyType": {
          "const": "provider-processing"
        },
        "version": {
          "const": "v2"
        },
        "canonicalPath": {
          "const": "docs/policies/provider-processing-policy.v2.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "externalExportPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyType",
        "version",
        "canonicalPath",
        "sha256"
      ],
      "properties": {
        "policyId": {
          "const": "external-export-policy"
        },
        "policyType": {
          "const": "external-export"
        },
        "version": {
          "const": "v2"
        },
        "canonicalPath": {
          "const": "docs/policies/external-export-policy.v2.json"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
